{
  "name": "destination-paradise",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-image-manifest.mjs && node scripts/build-sitemap.mjs && vite build && node scripts/build-spa-route-shells.mjs && node scripts/prerender.mjs && node scripts/build-staging-headers.mjs",
    "build:manifest": "node scripts/build-image-manifest.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "instagram:story:dry-run": "node scripts/instagram-story.mjs --dry-run",
    "instagram:story:publish": "node scripts/instagram-story.mjs --publish",
    "threads:comment:dry-run": "node scripts/threads-auto-commenter.mjs --dry-run",
    "threads:comment:publish": "node scripts/threads-auto-commenter.mjs --publish"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "opentype.js": "^2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^14.1.3",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sparticuz/chromium": "^149.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "puppeteer": "^25.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
