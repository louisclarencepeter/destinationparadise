{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_WEATHER_FORECAST_URL": "https://destination-paradise-mobile.netlify.app/api/weather"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "louisclarencepeters@gmail.com",
        "ascAppId": "6809042574",
        "appleTeamId": "86ZX7JC345"
      }
    }
  }
}
